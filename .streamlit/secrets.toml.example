# Optional: add a real key in secrets.toml on your own computer or hosting service.
# Never commit the real secrets.toml file or paste an API key into website code.
OPENAI_API_KEY = "your-api-key"

# Set both values for a public deployment. The app fails closed if public mode is
# enabled without session-isolated watchlists.
MARKET_LENS_PUBLIC = "false" # Change to true only for a publicly accessible deployment.
MARKET_LENS_HOSTED = "true"
